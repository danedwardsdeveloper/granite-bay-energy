<?xml version="1.0"?>
<ruleset name="Granite Bay Energy">
	<description>WordPress security and correctness rules. Formatting and naming follow this repo, not WPCS.</description>

	<file>wp-content/mu-plugins</file>
	<file>wp-content/themes/granite-bay</file>
	<file>config</file>
	<file>public/healthz.php</file>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.7"/>
	<config name="ignore_warnings_on_exit" value="1"/>

	<rule ref="WordPress.Security">
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
	</rule>
	<rule ref="WordPress.DB"/>
	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.DeprecatedParameters"/>
	<rule ref="WordPress.WP.DeprecatedClasses"/>
	<rule ref="WordPress.WP.DiscouragedFunctions"/>
	<rule ref="WordPress.WP.EnqueuedResources"/>
	<rule ref="WordPress.WP.PostsPerPage"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.PHP.StrictInArray"/>
	<rule ref="WordPress.PHP.DontExtract"/>
	<rule ref="WordPress.PHP.NoSilencedErrors"/>
	<rule ref="WordPress.PHP.PregQuoteDelimiter"/>
	<rule ref="WordPress.PHP.RestrictedPHPFunctions"/>

	<rule ref="Generic.PHP.DeprecatedFunctions"/>
	<rule ref="Generic.PHP.ForbiddenFunctions"/>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>
	<rule ref="Generic.CodeAnalysis.EmptyStatement"/>

	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>config/*\.php</exclude-pattern>
	</rule>
</ruleset>
