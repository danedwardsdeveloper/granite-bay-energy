{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/commit-entry-point.mjs\""
					},
					{
						"type": "command",
						"command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/protect-locked-comments.mjs\""
					}
				]
			},
			{
				"matcher": "Edit|Write|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/protect-locked-comments.mjs\""
					}
				]
			}
		]
	}
}
